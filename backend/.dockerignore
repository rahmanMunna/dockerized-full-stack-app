# Dependencies & build output (rebuilt inside the image)
node_modules
dist
coverage
*.tsbuildinfo

# Tests aren't needed to build or run the app
test
**/*.spec.ts

# Secrets (supply at runtime with -e / --env-file)
.env
.env.*
!.env.example

# VCS, Docker & editor files
.git
.gitignore
Dockerfile
.dockerignore
.vscode
.idea

# Logs & docs
npm-debug.log*
*.md
